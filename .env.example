# ============================================================
# Investment Tracker — Frontend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# URL of the backend API for the Vite dev server proxy.
# Only needed for local development — in production the frontend
# and backend share the same origin.
VITE_API_URL=http://localhost:5000

# Polygon.io API key.
# Used by Vite at build time (injected via process.env.VITE_POLYGON_API_KEY
# in vite.config.ts define block) and also read by the backend to serve
# to authenticated clients via GET /api/secrets/polygon-api-key.
# Free tier: https://polygon.io/dashboard
VITE_POLYGON_API_KEY=your_polygon_api_key_here

# ============================================================
# Backend configuration is separate from frontend .env vars.
# Backend secrets are configured via:
#   Local dev:  api/appsettings.Development.json
#               (copy from api/appsettings.Development.template.json)
#   Production: Heroku config vars (heroku config:set KEY=value)
#
# Backend secrets include:
#   - ConnectionStrings__DefaultConnection (PostgreSQL)
#   - Jwt__Key, Jwt__Issuer, Jwt__Audience
#   - SendGrid__ApiKey, SendGrid__FromEmail
#   - PolygonApiKey
#   - COINBASEAPIKEY, COINBASEAPISECRET
# ============================================================
